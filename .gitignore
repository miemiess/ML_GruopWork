# Python 与本地环境
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# 本地密钥
.env
.env.*
!.env.example

# 数据文件：本地存储目录中只保留说明或占位文件
/data/raw/*
!/data/raw/.gitkeep
# 保留三个数据集目录，仅跟踪各目录的占位文件。
!/data/raw/EMG_data_for_gestures-master/
/data/raw/EMG_data_for_gestures-master/*
!/data/raw/EMG_data_for_gestures-master/.gitkeep
!/data/raw/EMG_data_for_ZenodoTired/
/data/raw/EMG_data_for_ZenodoTired/*
!/data/raw/EMG_data_for_ZenodoTired/.gitkeep
!/data/raw/EMG_data_for_putemgforce/
/data/raw/EMG_data_for_putemgforce/*
!/data/raw/EMG_data_for_putemgforce/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# 本地运行结果与模型二进制文件
/results/runs/*
!/results/runs/.gitkeep
/deploy/force/input/*
!/deploy/force/input/.gitkeep
/deploy/force/output/*
!/deploy/force/output/.gitkeep
/deploy/force_change/input/*
!/deploy/force_change/input/.gitkeep
/deploy/force_change/output/*
!/deploy/force_change/output/.gitkeep
/deploy/gesture/input/*
!/deploy/gesture/input/.gitkeep
/deploy/gesture/output/*
!/deploy/gesture/output/.gitkeep
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.zip
*.tar
*.gz

# 本地配置与 Notebook
/configs/*.local.toml
.ipython/
.jupyter/

# 编辑器与操作系统文件
.vscode/
