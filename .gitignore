# Python 与本地环境
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# 本地密钥
.env
.env.*
!.env.example

# 数据文件：本地存储目录中只保留说明或占位文件
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# 本地运行结果与模型二进制文件
/results/runs/*
!/results/runs/.gitkeep
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.zip
*.tar
*.gz

# 本地配置与 Notebook
/configs/*.local.toml
.ipython/
.jupyter/

# 编辑器与操作系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
